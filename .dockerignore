# NetMCP Docker ignore file
# Exclude development and CI files from Docker image

# Git
.git/
.gitignore
.github/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.pnpm-debug.log*

# Testing
coverage/
.nyc_output/
test-smoke-results.txt
test-integration-results.txt
test-all.sh
test-integration.sh

# Development
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.env
.env.local
.env.*.local

# Documentation (kept: README, GETTING_STARTED, CHANGELOG, LICENSE)
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
MARKETPLACE.md
PUBLISHING.md
DEMO.md
demo-quick.sh
IMPROVEMENT_LOG.md
CODE_REVIEW_NOTES.md
REVIEW.md

# Package-specific dev files
packages/*/.actor/
packages/*/jsconfig.json
packages/*/package-lock.json

# Build artifacts
dist/
build/
*.tgz

# Docker
Dockerfile
docker-compose.yml
.dockerignore
